---
// "About the author" card for the homepage.
import { Icon } from '@astrojs/starlight/components';

const author = {
	name: 'Md. Anonto Shuvo',
	role: 'Software Engineer & Educator',
	bio: 'Blending industry experience with academic rigor to build better software.',
	links: [
		{ label: 'LinkedIn', icon: 'linkedin', href: 'https://www.linkedin.com/in/md-anonto-shuvo/' },
		{ label: 'GitHub', icon: 'github', href: 'https://github.com/shuvo-99' },
	],
} as const;

const initials = author.name
	.replace('Md.', '')
	.trim()
	.split(/\s+/)
	.map((word) => word[0])
	.join('');
---

<div
	class="not-content flex flex-col items-center gap-5 rounded-xl border border-(--sl-color-hairline) bg-(--sl-color-gray-7) p-6 dark:bg-(--sl-color-gray-6) text-center sm:flex-row sm:items-start sm:text-left"
>
	<div
		class="flex size-16 shrink-0 items-center justify-center rounded-full bg-(--sl-color-text-accent) text-xl font-semibold text-(--sl-color-black)"
		aria-hidden="true"
	>
		{initials}
	</div>

	<div class="flex flex-col gap-1">
		<p class="text-lg font-semibold text-(--sl-color-white)">{author.name}</p>
		<p class="text-sm font-medium text-(--sl-color-text-accent)">{author.role}</p>
		<p class="mt-1 text-(--sl-color-gray-2)">{author.bio}</p>

		<div class="mt-3 flex justify-center gap-4 sm:justify-start">
			{
				author.links.map((link) => (
					<a
						href={link.href}
						target="_blank"
						rel="noopener noreferrer"
						class="flex items-center gap-1.5 text-sm text-(--sl-color-gray-2) no-underline hover:text-(--sl-color-white)"
					>
						<Icon name={link.icon} size="1.1rem" />
						{link.label}
					</a>
				))
			}
		</div>
	</div>
</div>
